            "text": "How would you rate the environmental quality here, including noise, air, heat and greenery?",
            "answer_key": "environmental_quality_rating",
            "question_type": "single_option",
            "required": true,
            "options": [
              {"text": "Very poor", "value": "1_very_negative"},
              {"text": "Poor", "value": "2_negative"},
              {"text": "Neither poor nor good", "value": "3_neutral"},
              {"text": "Good", "value": "4_positive"},
              {"text": "Very good", "value": "5_very_positive"},
              {"text": "Not applicable / do not know", "value": "not_applicable"}
            ]
          },
