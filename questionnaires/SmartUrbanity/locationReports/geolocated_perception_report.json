              {"text": "Less than monthly", "value": "2_less_than_monthly"},
              {"text": "Monthly", "value": "3_monthly"},
              {"text": "Weekly", "value": "4_weekly"},
              {"text": "Daily or almost daily", "value": "5_daily"}
